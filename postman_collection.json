      "item": [
        {
          "name": "Create Space",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Creative Hub Kyiv\",\n  \"description\": \"Modern coworking with panoramic views\",\n  \"address\": \"вул. Хрещатик, 22\",\n  \"city\": \"Kyiv\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1497366216548-37526070297c?w=800\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/spaces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "spaces"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.response.to.have.header('Content-Type', /application\\/json/);",
                  "});",
                  "",
                  "pm.test('Response has id, name, city, imageUrl', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name', 'Creative Hub Kyiv');",
                  "    pm.expect(json).to.have.property('city', 'Kyiv');",
                  "    pm.expect(json).to.have.property('imageUrl');",
                  "});",
                  "",
                  "// Save id for subsequent requests",
                  "pm.collectionVariables.set('spaceId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
