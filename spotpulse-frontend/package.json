{
  "name": "spotpulse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:deployment": "tsc --noEmit && vite build --base=/app/",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e:prepare": "python ../spotpulse-backend/tools/prepare_e2e.py",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "assets:sync": "node scripts/sync-ui-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.6.1",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
