# Deny by default: send only inputs used by the production Dockerfile.
**
!Dockerfile
!spotpulse-backend/
!spotpulse-backend/pom.xml
!spotpulse-backend/mvnw
!spotpulse-backend/.mvn/
!spotpulse-backend/.mvn/**
!spotpulse-backend/src/
!spotpulse-backend/src/main/
!spotpulse-backend/src/main/**
!spotpulse-frontend/
!spotpulse-frontend/package.json
!spotpulse-frontend/package-lock.json
!spotpulse-frontend/index.html
!spotpulse-frontend/tsconfig.json
!spotpulse-frontend/vite.config.ts
!spotpulse-frontend/src/
!spotpulse-frontend/src/**
**/src/test/**
**/node_modules/**
**/target/**
**/bin/**
**/.git/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.mv.db
**/*.trace.db
**/*.log
